# ----------------------------------------------------------------------
# CPANEL PHP VERSION OVERRIDE (Bypass MultiPHP Manager Lock)
# ----------------------------------------------------------------------
# Jika fitur "Select PHP Version" / "MultiPHP Manager" di cPanel terkunci di PHP 8.1,
# direktif berikut memaksa web server (Apache/LiteSpeed) menggunakan PHP 8.4:
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  # Alternatif CloudLinux alt-php (jika host menggunakan CloudLinux):
  # AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
  # Alternatif jika server baru menyediakan PHP 8.3 / 8.2:
  # AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
  # AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Block access to hidden files and dotfiles (.env, .git, etc.)
    RewriteRule ^\.(.*)$ - [F,L]

    # 2. Canonical Domain Redirect: pksoganilir.com / www -> oganilir.pks.id
    RewriteCond %{HTTP_HOST} ^(www\.)?pksoganilir\.com$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.oganilir\.pks\.id$ [NC]
    RewriteRule ^(.*)$ https://oganilir.pks.id/$1 [L,R=301]

    # 3. Enforce HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 4. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 5. Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 6. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 7. Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Security Headers (Defense in Depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>
