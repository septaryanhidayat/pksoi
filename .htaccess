# ----------------------------------------------------------------------
# CPANEL PHP VERSION OVERRIDE (Bypass MultiPHP Manager Lock)
# ----------------------------------------------------------------------
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  # Alternatif CloudLinux alt-php:
  # AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
  # Alternatif jika server baru menyediakan PHP 8.3 / 8.2:
  # AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
  # AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# Disable directory indexing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Prevent access to hidden files and directories (like .env, .git)
    RewriteRule ^\.(.*)$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]

    # 2. Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|BACKUP|Desain)(\/.*)?$ - [F,L,NC]

    # 3. Block sensitive files and scripts in root
    RewriteRule ^(artisan|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|vite\.config\.js|boost\.json)$ - [F,L,NC]
    RewriteRule \.(sql|sqlite|sqlite3|log|key|md|bak|swp|xml)$ - [F,L,NC]

    # 4. Redirect all legitimate requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>

